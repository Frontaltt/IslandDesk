<Window x:Class="IslandDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island Desk"
        Width="900" Height="76"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="MiniLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot" Background="Transparent">
        <Border x:Name="IslandCard"
                Margin="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="25"
                Padding="12"
                RenderTransformOrigin="0.5,0.0">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.28" />
            </Border.Effect>
            <Grid x:Name="IslandContentRoot">
            <Grid x:Name="NormalIslandContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The brand area swaps to the action strip on hover; its width stays reserved to prevent flicker. -->
                <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="184" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BrandHoverArea" Grid.Column="0" Background="Transparent"
                            MouseEnter="BrandHoverArea_MouseEnter" MouseLeave="BrandHoverArea_MouseLeave">
                        <Grid>
                            <StackPanel x:Name="BrandDisplay" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="True">
                                <Border Width="28" Height="28" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="BrandTextBlock" Text="ISLAND DESK" Foreground="{DynamicResource TextBrush}"
                                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel x:Name="HeaderActionsPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="Left" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Button x:Name="ScreenshotButton" Style="{StaticResource IslandButton}" Width="26" Height="26" Padding="4" Content="▧" Click="Screenshot_Click" ToolTip="Capture screen (Snipping Tool)" />
                                <Button x:Name="EmojiButton" Style="{StaticResource IslandButton}" Width="26" Height="26" Padding="4" Margin="3,0,0,0" Content="☺" Click="Emoji_Click" ToolTip="Windows emoji picker" />
                                <Button x:Name="StudioButton" Style="{StaticResource IslandButton}" Width="26" Height="26" Padding="4" Margin="3,0,0,0" Content="✦" Click="Studio_Click" ToolTip="Open Island Desk Studio" />
                                <Button x:Name="SettingsButton" Style="{StaticResource IslandButton}" Width="26" Height="26" Padding="4" Margin="3,0,0,0" Content="⚙" Click="Settings_Click" ToolTip="Quick settings" />
                                <Button x:Name="ExpandButton" Style="{StaticResource IslandButton}" Width="26" Height="26" Padding="4" Margin="3,0,0,0" Content="⌄" Click="Expand_Click" ToolTip="Expand" />
                                <Button x:Name="CloseButton" Style="{StaticResource IslandButton}" Width="26" Height="26" Padding="4" Margin="3,0,0,0" Content="×" Click="Close_Click" ToolTip="Close" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <StackPanel x:Name="HeaderWidgetPanel" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border x:Name="CpuChip" Style="{StaticResource ChipStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="CPU" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,0,5,0" /><TextBlock x:Name="CpuTiny" Text="--%" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border x:Name="RamChip" Style="{StaticResource ChipStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="RAM" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,0,5,0" /><TextBlock x:Name="RamTiny" Text="--%" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border x:Name="GpuChip" Style="{StaticResource ChipStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="GPU" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,0,5,0" /><TextBlock x:Name="GpuTiny" Text="--%" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border x:Name="CpuTempChip" Style="{StaticResource ChipStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="CPU °" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,0,5,0" /><TextBlock x:Name="CpuTempTiny" Text="--°C" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border x:Name="GpuTempChip" Style="{StaticResource ChipStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="GPU °" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,0,5,0" /><TextBlock x:Name="GpuTempTiny" Text="--°C" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border x:Name="FpsChip" Style="{StaticResource ChipStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="FPS" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,0,5,0" /><TextBlock x:Name="FpsTiny" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border x:Name="ClockChip" Style="{StaticResource ChipStyle}" Margin="0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="◷" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,5,0" /><TextBlock x:Name="ClockTiny" Text="--:--" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Grid x:Name="HeaderMusic" Width="238" VerticalAlignment="Center" Margin="10,0,0,0"
                              MouseEnter="HeaderMusic_MouseEnter" MouseLeave="HeaderMusic_MouseLeave">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                                <Image x:Name="HeaderAlbumArt" Stretch="UniformToFill" Visibility="Collapsed" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TrackTitle" Text="Nothing playing" Foreground="{DynamicResource TextBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrackArtist" Text="Media session" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="HeaderMusicControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="Visible" Opacity="0" IsHitTestVisible="False">
                                <Button x:Name="HeaderPreviousButton" Style="{StaticResource IslandButton}" Width="23" Height="24" Padding="3" Content="|◀" Click="Previous_Click" ToolTip="Previous track" />
                                <Button x:Name="HeaderPlayButton" Style="{StaticResource IslandButton}" Width="25" Height="24" Padding="3" Margin="2,0" Content="▶" Click="PlayPause_Click" ToolTip="Play / pause" />
                                <Button x:Name="HeaderNextButton" Style="{StaticResource IslandButton}" Width="23" Height="24" Padding="3" Content="▶|" Click="Next_Click" ToolTip="Next track" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Expanded content -->
                <Grid x:Name="MainBody" Grid.Row="1" Visibility="Collapsed" Margin="2,8,2,2">
                    <Grid x:Name="OverviewPanel" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="SYSTEM" Style="{StaticResource MiniLabelStyle}" Margin="5,0,0,10" />
                            <UniformGrid x:Name="SystemCardsPanel" Grid.Row="1" Columns="2">
                                <Border x:Name="CpuCard" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="PROCESSOR" Style="{StaticResource MiniLabelStyle}" />
                                        <TextBlock x:Name="CpuLarge" Text="--%" Foreground="{DynamicResource TextBrush}" FontSize="25" FontWeight="Light" Margin="0,4,0,0" />
                                        <TextBlock Text="Overall usage" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="RamCard" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="MEMORY" Style="{StaticResource MiniLabelStyle}" />
                                        <TextBlock x:Name="RamLarge" Text="--%" Foreground="{DynamicResource TextBrush}" FontSize="25" FontWeight="Light" Margin="0,4,0,0" />
                                        <TextBlock x:Name="RamDetail" Text="-- / -- GB" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="GpuCard" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="GRAPHICS" Style="{StaticResource MiniLabelStyle}" />
                                        <TextBlock x:Name="GpuLarge" Text="--%" Foreground="{DynamicResource TextBrush}" FontSize="25" FontWeight="Light" Margin="0,4,0,0" />
                                        <TextBlock Text="Windows 3D engine" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="CpuTempCard" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="CPU TEMPERATURE" Style="{StaticResource MiniLabelStyle}" />
                                        <TextBlock x:Name="CpuTempLarge" Text="--°C" Foreground="{DynamicResource TextBrush}" FontSize="25" FontWeight="Light" Margin="0,4,0,0" />
                                        <TextBlock Text="CPU sensor" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="GpuTempCard" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="GPU TEMPERATURE" Style="{StaticResource MiniLabelStyle}" />
                                        <TextBlock x:Name="GpuTempLarge" Text="--°C" Foreground="{DynamicResource TextBrush}" FontSize="25" FontWeight="Light" Margin="0,4,0,0" />
                                        <TextBlock Text="GPU sensor" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="FpsCard" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="FRAME RATE" Style="{StaticResource MiniLabelStyle}" />
                                        <TextBlock x:Name="FpsLarge" Text="—" Foreground="{DynamicResource TextBrush}" FontSize="25" FontWeight="Light" Margin="0,4,0,0" />
                                        <TextBlock Text="RTSS must be running" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ClockCard" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="LOCAL TIME" Style="{StaticResource MiniLabelStyle}" />
                                        <TextBlock x:Name="ClockLarge" Text="--:--" Foreground="{DynamicResource TextBrush}" FontSize="25" FontWeight="Light" Margin="0,4,0,0" />
                                        <TextBlock x:Name="ClockDate" Text="Today" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="MediaHeading" Text="MEDIA" Style="{StaticResource MiniLabelStyle}" Margin="5,0,0,10" />
                            <Border x:Name="MediaCard" Background="{DynamicResource PanelAltBrush}" CornerRadius="16" Padding="13" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="♫" Foreground="{DynamicResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image x:Name="MediaAlbumArt" Stretch="UniformToFill" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="MediaLargeTitle" Text="Nothing playing" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="MediaLargeArtist" Text="Start Spotify or another player" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="MediaAppName" Text="WINDOWS MEDIA SESSION" Foreground="{DynamicResource MutedBrush}" FontSize="8" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IslandButton}" Content="|◀" Padding="8,8" Click="Previous_Click" ToolTip="Previous track" />
                                            <Button x:Name="MediaPlayButton" Style="{StaticResource IslandButton}" Content="▶" Padding="9,8" Margin="4,0" Click="PlayPause_Click" ToolTip="Play / pause" />
                                            <Button Style="{StaticResource IslandButton}" Content="▶|" Padding="8,8" Click="Next_Click" ToolTip="Next track" />
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="EqualizerPreviewPanel" Grid.Row="1" Margin="0,12,0,0" Padding="9,7"
                                            Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Cursor="Hand"
                                            MouseLeftButtonUp="EqualizerPreview_MouseLeftButtonUp" ToolTip="Open equalizer controls in Island Desk Studio">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="EQUALIZER" Foreground="{DynamicResource MutedBrush}" FontSize="8" FontWeight="Bold" />
                                                <TextBlock x:Name="EqualizerPreviewStatus" Text="10-BAND · STUDIO" Foreground="{DynamicResource AccentBrush}" FontSize="8" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border x:Name="EqPreviewBand0" Width="4" Height="7" Margin="2,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                                                <Border x:Name="EqPreviewBand1" Width="4" Height="11" Margin="2,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                                                <Border x:Name="EqPreviewBand2" Width="4" Height="15" Margin="2,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                                                <Border x:Name="EqPreviewBand3" Width="4" Height="10" Margin="2,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                                                <Border x:Name="EqPreviewBand4" Width="4" Height="17" Margin="2,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                                                <Border x:Name="EqPreviewBand5" Width="4" Height="13" Margin="2,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                                                <Border x:Name="EqPreviewBand6" Width="4" Height="18" Margin="2,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                                                <Border x:Name="EqPreviewBand7" Width="4" Height="12" Margin="2,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                                                <Border x:Name="EqPreviewBand8" Width="4" Height="9" Margin="2,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                                                <Border x:Name="EqPreviewBand9" Width="4" Height="6" Margin="2,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="↗" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,2,0" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="NotificationSectionTitle" Text="LATEST NOTIFICATION" Style="{StaticResource MiniLabelStyle}" Margin="5,0,0,8" />
                            <Border x:Name="NotificationPanel" Background="{DynamicResource PanelAltBrush}" CornerRadius="16" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="NotificationApp" Text="Waiting for notifications" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock x:Name="NotificationTitle" Text="Windows notifications will appear here" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="NotificationBody" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="42" />
                                        <TextBlock x:Name="NotificationStatus" Text="Connecting…" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IslandButton}" Content="↗" Padding="9,7" VerticalAlignment="Top" Click="NotificationPeek_Click" ToolTip="Show notification" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="8,2,15,0">
                            <TextBlock Text="WIDGET VISIBILITY" Style="{StaticResource MiniLabelStyle}" Margin="0,0,0,12" />
                            <CheckBox x:Name="ShowCpuCheck" Style="{StaticResource IslandCheckBox}" Content="CPU usage" Checked="SettingChanged" Unchecked="SettingChanged" />
                            <CheckBox x:Name="ShowRamCheck" Style="{StaticResource IslandCheckBox}" Content="RAM usage" Checked="SettingChanged" Unchecked="SettingChanged" />
                            <CheckBox x:Name="ShowGpuCheck" Style="{StaticResource IslandCheckBox}" Content="GPU usage" Checked="SettingChanged" Unchecked="SettingChanged" />
                            <CheckBox x:Name="ShowFpsCheck" Style="{StaticResource IslandCheckBox}" Content="FPS (via RTSS)" Checked="SettingChanged" Unchecked="SettingChanged" />
                            <CheckBox x:Name="ShowMusicCheck" Style="{StaticResource IslandCheckBox}" Content="Music player" Checked="SettingChanged" Unchecked="SettingChanged" />
                            <CheckBox x:Name="ShowNotificationsCheck" Style="{StaticResource IslandCheckBox}" Content="Windows notifications" Checked="SettingChanged" Unchecked="SettingChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,2,5,0">
                            <TextBlock Text="APPEARANCE" Style="{StaticResource MiniLabelStyle}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IslandButton}" Content="Dark theme" Click="DarkTheme_Click" />
                                <Button Style="{StaticResource IslandButton}" Content="Light theme" Margin="8,0,0,0" Click="LightTheme_Click" />
                            </StackPanel>
                            <TextBlock Text="" Margin="0,8,0,0" />
                            <TextBlock Text="HOTKEYS" Style="{StaticResource MiniLabelStyle}" Margin="0,8,0,8" />
                            <TextBlock Text="Ctrl + Shift + Space" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Expand / collapse island" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,9" />
                            <TextBlock Text="Ctrl + Shift + N" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Open latest notification" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                            <TextBlock Text="Settings are saved automatically." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="PeekPanel" Visibility="Collapsed" MaxWidth="600" HorizontalAlignment="Stretch" Margin="5,0"
                            Background="{DynamicResource PanelAltBrush}" CornerRadius="18" Padding="15"
                            Cursor="Hand" MouseLeftButtonUp="NotificationPeek_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                <TextBlock x:Name="PeekIcon" Text="✉" Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PeekApp" Text="New notification" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" />
                                <TextBlock x:Name="PeekTitle" Text="Title" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,2,0,0" />
                                <TextBlock x:Name="PeekBody" Text="Message" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IslandButton}" Content="Details" VerticalAlignment="Center" Click="NotificationPeek_Click" />
                        </Grid>
                    </Border>

                    <Border x:Name="NotificationDetailPanel" Visibility="Collapsed" MaxWidth="600" HorizontalAlignment="Stretch" Margin="5,0"
                            Background="{DynamicResource PanelAltBrush}" CornerRadius="20" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DetailNotificationApp" Text="APPLICATION" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DetailNotificationTitle" Text="Notification" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource IslandButton}" Content="×" Click="CloseNotificationDetails_Click" ToolTip="Close" />
                            </Grid>
                            <TextBlock x:Name="DetailNotificationTime" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,10" />
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="160">
                                <TextBlock x:Name="DetailNotificationBody" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                            </ScrollViewer>
                            <TextBlock Grid.Row="3" Text="Press Ctrl + Shift + N to reopen the latest notification" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,12,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Dedicated low-distraction gaming surface: glowing dot + notification capsule only. -->
            <Grid x:Name="GamingModeContent" Visibility="Collapsed" Background="Transparent">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                    <Border x:Name="GamingModeIndicator" Width="58" Height="28" CornerRadius="16"
                            Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" Padding="9,5">
                        <Grid>
                            <Ellipse x:Name="GamingGlowDot" Width="9" Height="9" Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Effect><DropShadowEffect Color="{DynamicResource AccentColorValue}" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <Border x:Name="GamingWidgetPanel" Visibility="Collapsed" MinWidth="112" Height="28"
                            Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="11,5" Margin="0,6,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="GamingWidgetLabel" Text="GPU" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="GamingWidgetValue" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="GameNotificationToast" Visibility="Collapsed" Width="390" MinHeight="70"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="13" Margin="0,8,0,0" MouseLeftButtonUp="GameNotificationPreview_MouseLeftButtonUp" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                <TextBlock x:Name="GameNotificationIcon" Text="✉" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,8,0">
                                <TextBlock x:Name="GameNotificationApp" Text="New notification" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                                <TextBlock x:Name="GameNotificationTitle" Text="Notification title" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="GameNotificationBody" Text="Message preview" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IslandButton}" Padding="8,5" Content="↗" Click="GameNotificationDetails_Click" ToolTip="Details" />
                        </Grid>
                    </Border>
                    <Border x:Name="GameNotificationDetails" Visibility="Collapsed" Width="390" MinHeight="130"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="16" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="GameDetailApp" Text="APPLICATION" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock x:Name="GameDetailTitle" Text="Notification" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource IslandButton}" Content="×" Click="CloseGameNotification_Click" />
                            </Grid>
                            <TextBlock x:Name="GameDetailTime" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,6,0,8" />
                            <ScrollViewer Grid.Row="2" MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="GameDetailBody" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
            </Grid>
        </Border>
        <Border x:Name="GlassHighlightOverlay" Margin="3" CornerRadius="25"
                BorderBrush="{DynamicResource GlassHighlightBrush}" BorderThickness="1"
                Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="20" />
    </Grid>
</Window>
