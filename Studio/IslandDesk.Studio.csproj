    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IslandDesk.Studio</AssemblyName>
    <RootNamespace>IslandDeskStudio</RootNamespace>
    <Version>1.3.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Models\AppSettings.cs" Link="Models\AppSettings.cs" />
    <Compile Include="..\Services\SettingsService.cs" Link="Services\SettingsService.cs" />
    <Compile Include="..\Services\EqualizerApoService.cs" Link="Services\EqualizerApoService.cs" />
  </ItemGroup>
</Project>
