<Application x:Class="IslandDeskStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Defaults are available before Studio applies the saved light/dark profile. -->
        <SolidColorBrush x:Key="StudioBg" Color="#FF0C0F15" />
        <SolidColorBrush x:Key="StudioPanel" Color="#FF171C26" />
        <SolidColorBrush x:Key="StudioControl" Color="#FF202735" />
        <SolidColorBrush x:Key="StudioSelected" Color="#333A315C" />
        <SolidColorBrush x:Key="StudioText" Color="#FFF4F6FA" />
        <SolidColorBrush x:Key="StudioMuted" Color="#FF98A3B5" />
        <SolidColorBrush x:Key="StudioStroke" Color="#FF30394A" />
        <SolidColorBrush x:Key="StudioAccent" Color="#FFA78BFA" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource StudioControl}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
            <Setter Property="Margin" Value="0,7,0,7" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource StudioControl}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioStroke}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="{DynamicResource StudioText}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource StudioControl}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource StudioSelected}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.82" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>
